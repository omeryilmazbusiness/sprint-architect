# Production environment template — copy to server secrets (never commit real values).
# See docs/PRODUCTION.md for deploy checklist.

NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/healthtour
DATABASE_URL_TEST=

SESSION_SECRET=generate-with-openssl-rand-base64-48
JWT_ACCESS_SECRET=generate-unique-access-secret
JWT_REFRESH_SECRET=generate-unique-refresh-secret

STORAGE_PROVIDER=s3
S3_BUCKET=your-production-bucket
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@healory.app

# Mobile builds (EAS) — HTTPS API required for App Store
EXPO_PUBLIC_API_URL=https://api.healory.app

APP_VERSION=1.0.0
