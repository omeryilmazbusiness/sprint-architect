{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:5001"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.healory.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sprint-architect-production.up.railway.app",
        "EXPO_PUBLIC_REVIEW_MODE": "1"
      }
    },
    "review": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sprint-architect-production.up.railway.app",
        "EXPO_PUBLIC_REVIEW_MODE": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "omerfarukyilmazrbusiness@gmail.com",
        "ascAppId": "6771757756",
        "appleTeamId": "4WJ7D3Y4ZD"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    },
    "review": {
      "ios": {
        "appleId": "omerfarukyilmazrbusiness@gmail.com",
        "ascAppId": "6771757756",
        "appleTeamId": "4WJ7D3Y4ZD"
      }
    }
  }
}
