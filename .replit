entrypoint = "README.md"
modules = ["nodejs-22", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[env]
PORT = "5000"

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DB Reset Launch"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Seed Demo Admin"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Seed Demo Guest"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Seed Demo Guest Unbound"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"
waitForPort = 8081
ensurePreviewReachable = "/status"

[[workflows.workflow]]
name = "DB Reset Launch"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development tsx server/scripts/resetLaunchDb.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Seed Demo Admin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development tsx server/scripts/seedDemoAdminOnly.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Seed Demo Guest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development tsx server/scripts/seedDemoGuestKey.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Seed Demo Guest Unbound"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development tsx server/scripts/seedDemoGuestUnbound.ts"

[workflows.workflow.metadata]
outputType = "console"
