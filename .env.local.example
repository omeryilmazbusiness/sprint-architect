# Copy to .env (shared) or .env.local (local overrides, gitignored):
#   cp .env.local.example .env

NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:55432/healthtour
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:55432/healthtour_test

SESSION_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_SECRET=ht-access-secret-dev-only
JWT_REFRESH_SECRET=ht-refresh-secret-dev-only

# iOS Simulator → Mac localhost. Physical device → your Mac LAN IP, e.g. http://192.168.1.10:5000
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# Set to 1 to preview App Store review copy (Community / Member / Host / Events)
# EXPO_PUBLIC_REVIEW_MODE=1

STORAGE_PROVIDER=local
GUEST_MULTI_DEVICE_DEMO=true
