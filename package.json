{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:setup": "npm run db:up && sleep 3 && npm run db:migrate && npm run db:seed",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:dev": "npx expo start --localhost",
    "expo:ios": "npx expo run:ios",
    "expo:ios:sim": "bash scripts/start-ios.sh",
    "dev": "bash scripts/dev.sh",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:test:ensure": "bash scripts/ensure-test-db.sh",
    "start": "npx expo start",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "test": "npm run typecheck && NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "db:migrate": "drizzle-kit push",
    "db:seed": "tsx server/seed.ts",
    "test:db:reset": "NODE_ENV=test tsx server/scripts/resetTestDb.ts",
    "test:db:minimal-reset": "NODE_ENV=test DATABASE_URL=${DATABASE_URL_TEST:-$DATABASE_URL} tsx server/scripts/resetTestDbMinimal.ts",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.11",
    "@ungap/structured-clone": "^1.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "expo": "~54.0.27",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~18.0.11",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.4",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "express": "^5.0.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.40",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.20.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tsx": "^4.20.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
