# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/healthtour

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Expo / Frontend ─────────────────────────────────────────────────────────
EXPO_PUBLIC_DOMAIN=https://your-replit-dev-domain.replit.dev

# ─── File Storage ─────────────────────────────────────────────────────────────
# Set to "local" for development (files saved under ./uploads/)
# Set to "s3"    for production (files saved to an S3-compatible bucket)
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# Optional – set for MinIO or other S3-compatible services
# S3_ENDPOINT=https://minio.example.com
# S3_FORCE_PATH_STYLE=true
